# ── Core ──────────────────────────────────────────────────────────────────────
# Required for AI agent planning
ANTHROPIC_API_KEY=
# SQLite for local dev, PostgreSQL for production:
# DATABASE_URL=sqlite+aiosqlite:///./travel_agent.db
DATABASE_URL=postgresql+asyncpg://travel:travel@localhost:5432/travel_agent
# Set to true to use real booking APIs
USE_REAL_APIS=false
APPROVAL_TIMEOUT_MINUTES=30
MAX_AGENT_ITERATIONS=10
LOG_LEVEL=INFO

# ── Real API Providers (required when USE_REAL_APIS=true) ─────────────────────
# Duffel — primary provider for flights and hotels
DUFFEL_API_TOKEN=
RAILEUROPE_API_KEY=
HERTZ_CLIENT_ID=
HERTZ_CLIENT_SECRET=
VIATOR_API_KEY=

# ── Fallback Providers ───────────────────────────────────────────────────────
# Amadeus — fallback for flights
AMADEUS_CLIENT_ID=
AMADEUS_CLIENT_SECRET=
AMADEUS_HOSTNAME=test.api.amadeus.com
# Booking.com — fallback for hotels
BOOKINGCOM_API_KEY=
GETYOURGUIDE_API_KEY=

# ── M8: Redis Cache ─────────────────────────────────────────────────────────
# Leave empty to disable caching (graceful degradation).
REDIS_URL=

# ── M8: Price Re-Verification ───────────────────────────────────────────────
# Maximum price change (%) before re-approval is required (INV-13).
PRICE_CHANGE_THRESHOLD_PCT=5.0

# ── Authentication ────────────────────────────────────────────────────────────
# JWT signing secret — set this to enable authentication.
# Leave empty to disable authentication (dev/test mode).
JWT_SECRET=
# Legacy alias (still works if JWT_SECRET is empty):
AUTH_SECRET=
AUTH_PROVIDER_URL=

# ── Google OAuth ──────────────────────────────────────────────────────────────
# Create credentials at https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/callback/google
FRONTEND_URL=http://localhost:3000
JWT_EXPIRY_HOURS=72

# ── Waitlist / Invite Codes ─────────────────────────────────────────────────
INVITE_CODES=
WAITLIST_ENABLED=true

# ── Stripe Payments ──────────────────────────────────────────────────────────
# Get keys at https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
SERVICE_FEE_CENTS=999

# ── Email (Resend) ──────────────────────────────────────────────────────────
# Get API key at https://resend.com/api-keys
RESEND_API_KEY=
EMAIL_FROM=Concierge <bookings@concierge.com>

# ── Push Notifications (M6) ──────────────────────────────────────────────────
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_CONTACT_EMAIL=
